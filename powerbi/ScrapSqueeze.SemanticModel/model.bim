          },
          {
            "name": "OECD Export Pull 2025 (Mt)",
            "expression": "CALCULATE ( [Scrap Exports (Mt)], Trade[partner_group] = \"OECD\", Trade[year] = 2025, REMOVEFILTERS ( 'Date' ) )",
            "formatString": "#,##0.0",
            "lineageTag": "4c84ca35-96bb-47cc-8f9b-b785b1d569d4"
          },
          {
            "name": "Base Surplus 2030 (Mt)",
            "expression": "CALCULATE ( [Exportable Surplus (Mt)], 'Scenario Surplus'[scenario] = \"Base\", 'Scenario Surplus'[year] = 2030 )",
            "formatString": "#,##0.0",
            "lineageTag": "e59744b3-2276-47fd-991d-06b125a59d13"
          }
        ],
        "partitions": [
