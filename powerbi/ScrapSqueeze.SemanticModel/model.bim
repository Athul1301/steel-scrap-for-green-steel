          },
          {
            "name": "partner_name",
            "dataType": "string",
            "lineageTag": "248f8a60-245c-4eca-bef5-721db764b888",
            "sourceColumn": "partner_name",
            "summarizeBy": "none"
          },
          {
            "name": "partner_group",
            "dataType": "string",
            "lineageTag": "7610b1ba-6ad0-497f-82c1-2042826d5f1a",
