          },
          {
            "name": "product_name",
            "dataType": "string",
            "lineageTag": "1e85fb02-fcce-4c67-b022-cb282846aa41",
            "sourceColumn": "product_name",
            "summarizeBy": "none"
          },
          {
            "name": "flow",
            "dataType": "string",
            "lineageTag": "5d6f6e62-b00f-414d-8cc6-79c2ed2c12cd",
            "sourceColumn": "flow",
            "summarizeBy": "none"
          },
          {
            "name": "tonnes",
            "dataType": "double",
            "lineageTag": "da6cd33b-a498-4720-a34f-efec0fe1c444",
            "sourceColumn": "tonnes",
            "summarizeBy": "sum"
          },
          {
            "name": "eur",
            "dataType": "double",
            "lineageTag": "eb5c9005-93de-46c7-9641-08ca28593b13",
            "sourceColumn": "eur",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "26da7c84-0a31-43c9-acee-10af6b56026b",
        "measures": [
          {
            "name": "Scrap Exports (Mt)",
            "displayFolder": "Scrap trade",
            "expression": "CALCULATE ( DIVIDE ( SUM ( Trade[tonnes] ), 1000000 ), Trade[product] = \"7204\", Trade[flow] = \"export\", KEEPFILTERS ( Trade[partner_group] IN { \"OECD\", \"non-OECD\" } ) )",
            "formatString": "#,##0.00",
            "lineageTag": "4c23454a-33d5-4cf0-a95f-78de08ddebcc"
          },
          {
            "name": "Scrap Exports to non-OECD (Mt)",
            "displayFolder": "Scrap trade",
            "expression": "CALCULATE ( [Scrap Exports (Mt)], Trade[partner_group] = \"non-OECD\" )",
            "formatString": "#,##0.00",
            "lineageTag": "02c42b83-8db7-47af-846f-7838c2fab54b"
          },
          {
            "name": "non-OECD Share %",
            "displayFolder": "Scrap trade",
            "expression": "DIVIDE ( [Scrap Exports to non-OECD (Mt)], [Scrap Exports (Mt)] )",
            "formatString": "0.0%",
            "lineageTag": "05c2d755-afb1-4b69-a19d-18eb828a5dc6"
          },
          {
            "name": "Scrap Imports (Mt)",
            "displayFolder": "Scrap trade",
            "expression": "CALCULATE ( DIVIDE ( SUM ( Trade[tonnes] ), 1000000 ), Trade[product] = \"7204\", Trade[flow] = \"import\", Trade[partner] = \"EXT_EU\" )",
            "formatString": "#,##0.00",
            "lineageTag": "72dae0ef-9a49-40b6-a909-e3430e29109c"
          },
          {
            "name": "Net Scrap Exports (Mt)",
            "displayFolder": "Scrap trade",
            "expression": "CALCULATE ( DIVIDE ( SUM ( Trade[tonnes] ), 1000000 ), Trade[product] = \"7204\", Trade[flow] = \"export\", Trade[partner] = \"EXT_EU\" ) - [Scrap Imports (Mt)]",
            "formatString": "#,##0.00",
            "lineageTag": "cbccbc26-5cff-4de1-bc4d-5d828440a26e"
          },
          {
            "name": "Scrap Export Price (EUR/t)",
            "displayFolder": "Prices",
            "expression": [
              "VAR Eur = CALCULATE ( SUM ( Trade[eur] ), Trade[product] = \"7204\", Trade[flow] = \"export\", Trade[partner_group] IN {\"OECD\", \"non-OECD\"} )",
              "VAR Tonnes = CALCULATE ( SUM ( Trade[tonnes] ), Trade[product] = \"7204\", Trade[flow] = \"export\", Trade[partner_group] IN {\"OECD\", \"non-OECD\"} )",
              "RETURN DIVIDE ( Eur, Tonnes )"
            ],
            "formatString": "#,##0",
            "lineageTag": "d5f2c1ba-2c15-4d1a-bc3c-93cc8ab4cfd6"
          },
          {
            "name": "Pig Iron Import Price (EUR/t)",
            "displayFolder": "Prices",
            "expression": [
              "VAR Eur = CALCULATE ( SUM ( Trade[eur] ), Trade[product] = \"7201\", Trade[flow] = \"import\", Trade[partner] = \"EXT_EU\" )",
              "VAR Tonnes = CALCULATE ( SUM ( Trade[tonnes] ), Trade[product] = \"7201\", Trade[flow] = \"import\", Trade[partner] = \"EXT_EU\" )",
              "RETURN DIVIDE ( Eur, Tonnes )"
            ],
            "formatString": "#,##0",
            "lineageTag": "8267e2c2-aa3d-4a68-9fe8-2657216cc391"
          },
          {
            "name": "DRI Import Price (EUR/t)",
            "displayFolder": "Prices",
            "expression": [
              "VAR Eur = CALCULATE ( SUM ( Trade[eur] ), Trade[product] = \"720310\", Trade[flow] = \"import\", Trade[partner] = \"EXT_EU\" )",
              "VAR Tonnes = CALCULATE ( SUM ( Trade[tonnes] ), Trade[product] = \"720310\", Trade[flow] = \"import\", Trade[partner] = \"EXT_EU\" )",
              "RETURN DIVIDE ( Eur, Tonnes )"
            ],
            "formatString": "#,##0",
            "lineageTag": "4538c47b-2227-478f-814b-b0d0c9819fba"
          },
          {
            "name": "Scrap Exports YoY %",
            "displayFolder": "Scrap trade",
            "expression": [
              "VAR Cur = [Scrap Exports (Mt)]",
              "VAR Prev = CALCULATE ( [Scrap Exports (Mt)], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )",
              "RETURN DIVIDE ( Cur - Prev, Prev )"
            ],
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "2e3d1cf5-4d2f-426a-a81b-75c4a3f9be8f"
          },
          {
            "name": "Primary Metallics Imports (Mt)",
            "displayFolder": "Substitutes",
            "expression": "CALCULATE ( DIVIDE ( SUM ( Trade[tonnes] ), 1000000 ), Trade[product] IN {\"7201\", \"720310\"}, Trade[flow] = \"import\", Trade[partner_group] IN {\"OECD\", \"non-OECD\"} )",
            "formatString": "#,##0.00",
            "lineageTag": "e875e4b0-dca9-40ca-b491-ac378a9f7b3e"
          }
        ],
        "partitions": [
          {
            "name": "Trade",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"fact_trade_monthly.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Kept = Table.SelectColumns(Promoted, {\"date\", \"year\", \"partner\", \"partner_name\", \"partner_group\", \"product\", \"product_name\", \"flow\", \"tonnes\", \"eur\"}),",
                "    Typed = Table.TransformColumnTypes(Kept, {{\"date\", type date}, {\"year\", Int64.Type}, {\"partner\", type text}, {\"partner_name\", type text}, {\"partner_group\", type text}, {\"product\", type text}, {\"product_name\", type text}, {\"flow\", type text}, {\"tonnes\", type number}, {\"eur\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
