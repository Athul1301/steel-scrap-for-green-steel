            "sourceColumn": "Month",
            "summarizeBy": "none"
          },
          {
            "name": "Month Name",
            "dataType": "string",
            "lineageTag": "f9c7088b-5b1d-42fc-8171-9bdaead6352e",
            "sortByColumn": "Month",
            "sourceColumn": "Month Name"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "7f072c4b-992e-46e0-90b5-321db2906934",
        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Dates = List.Dates(#date(2015, 1, 1), Duration.Days(#date(2026, 12, 31) - #date(2015, 1, 1)) + 1, #duration(1, 0, 0, 0)),",
                "    T = Table.FromList(Dates, Splitter.SplitByNothing(), {\"Date\"}),",
                "    Typed = Table.TransformColumnTypes(T, {{\"Date\", type date}}),",
                "    Y = Table.AddColumn(Typed, \"Year\", each Date.Year([Date]), Int64.Type),",
                "    M = Table.AddColumn(Y, \"Month\", each Date.Month([Date]), Int64.Type),",
                "    MN = Table.AddColumn(M, \"Month Name\", each Date.ToText([Date], \"MMM\", \"en-US\"), type text)",
                "in",
                "    MN"
              ],
              "type": "m"
            }
          }
        ]
      },
